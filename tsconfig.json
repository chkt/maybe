{
	"include" : [ "./source/**/*.ts", "./test/**/*.ts" ],
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",

		"target": "es2020",
		"lib" : [],
		"types" : [ "node" ],

		"module": "nodenext",
		"moduleResolution" : "nodenext",
		"allowImportingTsExtensions" : false,

		"newLine": "LF",
		"sourceMap": false,
		"declaration": true,

		"strict": true,

		"removeComments": true
	}
}
