{
	"include" : [ "./source/**/*.ts", "./test/**/*.ts" ],
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",

		"target": "es2020",
		"lib" : [],

		"module": "nodenext",
		"moduleResolution" : "nodenext",
		"allowImportingTsExtensions" : false,

		"newLine": "LF",

		"sourceMap": false,
		"declaration": true,

		"strict": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,

		"removeComments": true
	}
}
