{
	"name": "@chkt/maybe",
	"description": "Minimalistic application flow handling",
	"version": "1.0.0-beta.12",
	"license": "MIT",
	"keywords": [
		"Failure",
		"Monad",
		"None",
		"Option",
		"Result",
		"Some"
	],
	"author": {
		"name": "chkt",
		"email": "ck@chkt.one",
		"url": "https://chkt.one"
	},
	"repository": {
		"type" : "git",
		"url": "git+https://github.com/chkt/maybe.git"
	},
	"type": "module",
	"engines": {
		"node": ">=18.0"
	},
	"main": "./dist/index.js",
	"files": [
		"./dist/"
	],
	"scripts": {
		"prepublishOnly": "npm outdated && npm test && npm run lint && npm run build && npm run doc",
		"lint" : "eslint 'source/**/*.ts' 'test/**/*.ts'",
		"test" : "NODE_OPTIONS='--loader ts-node/esm' mocha -r ts-node/register 'test/**/*.ts'",
		"coverage" : "NODE_OPTIONS='--loader ts-node/esm' c8 --reporter html --reporter text mocha -r ts-node/register 'test/**/*.ts'",
		"doc": "typedoc --plugin ../../chkt/typedoc-theme-md/dist/index.js --theme md --readme ./module.md --out readme.md 'source/**/*.ts'",
		"build": "rm -rf ./dist/* && tsc -p tsconfig.build.json"
	},
	"dependencies": {},
	"devDependencies": {
		"@chkt/eslint-config": "^1.1.1",
		"@eslint/js" : "^9.39",
		"@types/mocha": "^10.0",
		"@types/node": "^26.5",
		"c8": "^12.0",
		"eslint-plugin-import": "^2.32",
		"mocha": "^12.0",
		"ts-node": "^10.9",
		"typedoc": "^0.28",
		"typescript": "^6.0",
		"typescript-eslint" : "^8.70"
	}
}
